# Optional. Public https access through a Cloudflare Tunnel. See "Public access" in the README.
# COMPOSE_PROFILES=tunnel
# TUNNEL_TOKEN=

# Soft cap for downloaded audio, in GB.
CACHE_MAX_GB=2

# Videos longer than this many minutes are rejected.
MAX_DURATION_MIN=60

# Optional. Path inside the container to a cookies file, for example /data/cookies.txt
YTDLP_COOKIES=

# Optional. Set to 1 to log each device's sync status every 5 seconds.
SYNC_LOG=
